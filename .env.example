# --- Login (wajib) ---
# Email yang dipakai untuk login.
AUTH_EMAIL=kamu@email.com
# Hash bcrypt dari password kamu. Generate dengan: npm run hash-password -- "passwordkamu"
AUTH_PASSWORD_HASH=

# String acak untuk enkripsi session NextAuth. Generate dengan: openssl rand -base64 32
NEXTAUTH_SECRET=
# URL deployment kamu, misal http://localhost:3000 saat dev, atau https://agenda-kamu.vercel.app saat production
NEXTAUTH_URL=http://localhost:3000

# --- Penyimpanan data (opsional untuk dev, WAJIB untuk production di Vercel) ---
# Didapat otomatis kalau kamu connect Vercel KV / Upstash Redis dari dashboard Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- AI Chatbot (opsional, pilih salah satu) ---
# Groq (GRATIS): daftar di console.groq.com → API Keys → Create API Key
GROQ_API_KEY=
# OpenAI (berbayar): platform.openai.com/api-keys
OPENAI_API_KEY=
